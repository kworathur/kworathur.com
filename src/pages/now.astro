---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostBody from '../components/PostBody.astro';
import { formatDate, getNowPage } from '../lib/posts';

const now = await getNowPage();
---

<BaseLayout title="Now" description="What Keshav Worathur is working on now.">
  <article>
    <header class="post-header">
      <h1>Now</h1>
      <p class="meta">
        Last updated <time datetime={now.updated}>
          {
            formatDate(now.updated, {
              month: 'long',
              day: 'numeric',
              year: 'numeric',
            })
          }
        </time>
      </p>
    </header>
    <PostBody body={now.body} />
    <p class="meta">
      This is a <a
        href="https://nownownow.com/about"
        target="_blank"
        rel="noopener noreferrer">now page</a
      >.
    </p>
  </article>
</BaseLayout>
