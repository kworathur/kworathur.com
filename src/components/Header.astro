---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isNow = path === '/now';
---

<header class="site-header">
  <a href="/" class="logo" aria-label="Keshav Worathur home">kW</a>
  <nav aria-label="Primary">
    <a href="/" aria-current={path === '/' ? 'page' : undefined}>home</a>
    <a href="/now" aria-current={isNow ? 'page' : undefined}>now</a>
  </nav>
</header>
