---
const links = [
  {
    label: 'Resume',
    href: 'https://uploads.kworathur.com/keshav_worathur_resume.pdf',
  },
  { label: 'GitHub', href: 'https://github.com/kworathur' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/kworathur' },
  { label: 'Email', href: 'mailto:kworathur3@gatech.edu' },
];
---

<section class="intro">
  <h1>Keshav W.</h1>
  <p>
    Open source contributor and SWE at <a
      href="https://www.matmerize.com/"
      target="_blank">Matmerize</a
    >, where I develop backend infrastructure for AI-driven polymer design.
  </p>
  <p class="intro-links">
    {
      links.map((link, i) => (
        <>
          {i > 0 && <span aria-hidden="true">·</span>}
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={
              link.href.startsWith('http') ? 'noopener noreferrer' : undefined
            }
          >
            {link.label}
          </a>
        </>
      ))
    }
  </p>
</section>
