          </svg>
        </span>
        <span class={styles.socialHandle}>kworathur</span>
      </a>
      <a
        href="mailto:kworathur3@gatech.edu"
        class={styles.socialBtn}
        aria-label="Email"
      >
        <span class={`${styles.socialIcon} ${styles.socialIconEmail}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M0 3v18h24v-18h-24zm21.518 2l-9.518 7.713-9.518-7.713h19.036zm-19.518 14v-11.817l10 8.104 10-8.104v11.817h-20z"/>
          </svg>
        </span>
        <span class={styles.socialHandle}>kworathur3@gatech.edu</span>
      </a>
    </div>
  </div>

  <div class={styles.statsGrid} data-stats-grid>
    <div class={`${styles.stat} ${styles.statBlue}`} data-stat>
      <div class={styles.statNumber} data-countup="43" data-suffix="%">43%</div>
      <div class={styles.statLabel}>increase in hourly job throughput after prediction engine refactor</div>
    </div>
    <div class={styles.stat} data-stat>
      <div class={styles.statNumber} data-countup="16" data-suffix="K">16K</div>
      <div class={styles.statLabel}>protein structures used in parallel feature extraction at Gene2Lead</div>
    </div>
    <div class={styles.stat} data-stat>
      <div class={styles.statNumber} data-countup="20" data-suffix=" hours">20 hours</div>
      <div class={styles.statLabel}>time saved by developing API endpoints for chemical property prediction</div>
    </div>
    <a
      href="mailto:kworathur3@gatech.edu"
      class={`${styles.stat} ${styles.statCta}`}
      aria-label="Contact Keshav"
      data-stat
    >
      <div class={styles.statCtaHeading}>Open to new opportunities</div>
      <div class={styles.statCtaLink}>Get in touch →</div>
    </a>
  </div>
</section>

<script is:inline>
  (function () {
    const grid = document.querySelector('[data-stats-grid]');
    if (!grid) return;

    const stats = Array.from(grid.querySelectorAll('[data-stat]'));

    // Hide tiles immediately so they can animate in (progressive enhancement —
    // if JS is unavailable the inline style is never set and stats remain visible).
    stats.forEach(function (el) { el.style.opacity = '0'; });

    // Reveal tiles with staggered animation when grid enters the viewport.
    new IntersectionObserver(function (entries, obs) {
      if (!entries[0].isIntersecting) return;
      stats.forEach(function (el) {
        el.style.opacity = '';        // let the CSS animation drive opacity
        el.setAttribute('data-visible', '');
      });
      obs.disconnect();

      // Count-up numbers after the first tile starts animating.
      setTimeout(startCountUp, 80);
    }, { threshold: 0.25 }).observe(grid);

    function startCountUp() {
      grid.querySelectorAll('[data-countup]').forEach(function (el) {
        var target = +el.dataset.countup;
        var suffix = el.dataset.suffix || '';
        var duration = 900;
        var t0 = performance.now();

        function tick(now) {
          var p = Math.min((now - t0) / duration, 1);
          var eased = 1 - Math.pow(1 - p, 3); // ease-out cubic
          el.textContent = Math.round(eased * target) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
      });
    }
  })();
</script>
