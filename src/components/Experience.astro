---
/**
 * experience.astro
 * Replaces experiences.tsx, removing the useStaticQuery/gatsby-plugin-image dependency.
 * Loads experience data from resume.json (IDs to display) and cv.json (full details).
 * experience carousel images are served as static files from /assets/screens/.
 */
import resume from '../data/resume.json';
import cv from '../data/cv.json';
import styles from './Experience.module.scss';

// Filter the full experience list to only those listed in resume.json
const experienceIds: string[] = resume.experience;
const experiences = cv.experiences.filter((e) => experienceIds.includes(e.id));

---
<>
  <h2 class="section-title">
    My Work | <span class="detail">building ML systems for production</span>
  </h2>

  <div class="section">
    {experiences.map((experience) => {
      const images = experience['images'];
      return (
        <div>
          <h3 class={styles.experienceHeading}>{experience.position} @ {experience.company}</h3>
          <p>{experience.summary}</p>

          {/* Carousel: only rendered when images exist for this experience */}
          {images.length > 0 && (
            <div class={styles.experienceMediaCarousel}>
              <ul class={styles.carousel}>
                {images.map((src, i) => (
                  <li
                    class={styles.carouselSlide}
                    data-label={`Slide ${i + 1}`}
                    style={`--thumbnail: url(${src})`}
                  >
                    <img src={src} alt={`${experience.company} screenshot ${i + 1}`} />
                  </li>
                ))}
              </ul>
            </div>
          )}

          <ul>
            {experience.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
          <div class="techstack">
            {experience.technologies.map((tech) => (
              <div class="tech">{tech}</div>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</>
