---
/**
 * Projects.astro
 * Replaces Projects.tsx, removing the useStaticQuery/gatsby-plugin-image dependency.
 * Loads project data from resume.json (IDs to display) and cv.json (full details).
 * Project carousel images are served as static files from /assets/screens/.
 */
import resume from '../data/resume.json';
import cv from '../data/cv.json';
import styles from './Projects.module.scss';

// Filter the full project list to only those listed in resume.json
const projectIds: string[] = resume.projects;
const projects = cv.projects.filter((p) => projectIds.includes(p.id));

// Map of known project image counts; images follow {projectId}-screen{n}.png naming
// Only include images known to exist in public/assets/screens/
const projectImages: Record<string, string[]> = {
  g2l: ['/assets/screens/g2l-screen1.png', '/assets/screens/g2l-screen2.png'],
};
---
<>
  <h2 class="section-title">
    My Work | <span class="detail">work experiences and projects</span>
  </h2>

  <div class="section">
    {projects.map((project) => {
      const images = projectImages[project.id] ?? [];
      return (
        <div>
          <h3 class={styles.projectHeading}>{project.name}</h3>
          <p>{project.summary}</p>

          {/* Carousel: only rendered when images exist for this project */}
          {images.length > 0 && (
            <div class={styles.projectMediaCarousel}>
              <ul class={styles.carousel}>
                {images.map((src, i) => (
                  <li
                    class={styles.carouselSlide}
                    data-label={`Slide ${i + 1}`}
                    style={`--thumbnail: url(${src})`}
                  >
                    <img src={src} alt={`${project.name} screenshot ${i + 1}`} />
                  </li>
                ))}
              </ul>
            </div>
          )}

          <ul>
            {project.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
          <div class="techstack">
            {project.technologies.map((tech) => (
              <div class="tech">{tech}</div>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</>
