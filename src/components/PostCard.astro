---
import styles from './PostCard.module.scss';

interface Props {
  title: string;
  slug: string;
  date: string;
}

const { title, slug, date } = Astro.props;
const link = `/blog/${slug}`;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article class={styles.post}>
  <div class={styles.titleLine}>
    <h3 class={styles.title}>
      <a href={link}>{title}</a>
    </h3>
    <p class={styles.date}>{formattedDate}</p>
  </div>
</article>
