---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import styles from './PostCard.module.scss';

interface Props {
  title: string;
  slug: string;
  description: string;
  date: string;
  featuredImage: ImageMetadata;
  tags?: string[];
}

const { title, slug, description, date, featuredImage, tags } = Astro.props;
const link = `/blog/${slug}`;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---
<article class={styles.post}>
  <a href={link} class={styles.imageLink} aria-label={`Read ${title}`}>
    <Image
      src={featuredImage}
      alt={`${title} header`}
      width={400}
      height={240}
      class={styles.image}
    />
  </a>
  <div class={styles.body}>
    <h3 class={styles.title}>
      <a href={link}>{title}</a>
    </h3>
    <p class={styles.excerpt}>{description}</p>
    {tags && tags.length > 0 && (
      <div class={styles.tags}>
        {tags.map((tag) => <div class="tech">{tag}</div>)}
      </div>
    )}
    <p class={styles.date}>{formattedDate}</p>
  </div>
</article>
